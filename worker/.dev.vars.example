# Template for worker/.dev.vars — copy to `.dev.vars` and fill in for local dev:
#   cp .dev.vars.example .dev.vars
#
# `wrangler dev` reads both plain vars and secrets from `.dev.vars` in local
# mode, overriding the empty [vars] in wrangler.toml. `.dev.vars` is git-ignored.

# Public client ids (same as root .env).
GOOGLE_CLIENT_ID=
DROPBOX_CLIENT_ID=

# Allowed caller origin(s). Safari and Firefox extension UUIDs are dynamic, so
# retain their scheme wildcards alongside the stable Chrome store id.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://jbhlmonpecgenhinhffclanbbknjlbeh,moz-extension://*,safari-web-extension://*

# OAuth client secrets (local only; never commit).
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_SECRET=

# Opt-in product feedback → GitHub Issues (local only; never commit).
# Fine-grained PAT with Issues: Write on gnasdev/gn-tracing.
GITHUB_FEEDBACK_TOKEN=
GITHUB_REPO_OWNER=gnasdev
GITHUB_REPO_NAME=gn-tracing
GITHUB_FEEDBACK_LABELS=feedback
