ENV=production
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CHROME_EXTENSION_ID=your-chrome-extension-id
CHROME_EXTENSION_PUBLIC_KEY=your-chrome-extension-public-key
CHROME_EXTENSION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_PAGES_PROJECT=gn-tracing-player
PLAYER_HOST_URL=https://tracing.gnas.dev/
PLAYER_LOCAL_PORT=5173
VITE_BASE_PATH=/
