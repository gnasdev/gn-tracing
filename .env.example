ENV=production
GOOGLE_CLIENT_ID=480452534376-na7me1e7ss7pmucni3vvkueai6gr8qpj.apps.googleusercontent.com
# OAuth client secret for the "Web application" client. Used ONLY by the
# Cloudflare Worker (worker/deploy.sh sets it as an encrypted secret). It is
# never bundled into the extension. Leave empty unless deploying the Worker.
GOOGLE_CLIENT_SECRET=
# URL of the deployed OAuth token-exchange Worker (e.g.
# https://gn-tracing-oauth-proxy.<subdomain>.workers.dev). Used for production
# builds (`task dist`) only. When set, the extension sends token requests here
# instead of directly to Google, so the client_secret stays server-side. Leave
# empty to call Google directly (only works for public/installed OAuth clients
# that accept PKCE without a secret).
GOOGLE_TOKEN_PROXY_URL=
# Override for dev/watch builds (`task dev` / `task build`) only. Defaults to
# http://localhost:8787 when empty so `task dev` uses the local multi-issuer
# Worker. Production builds ignore this override.
GOOGLE_TOKEN_PROXY_URL_DEV=
# Dropbox App Console → Scoped access app → App key (public client preferred).
# Enable PKCE / no secret when possible. Add chrome.identity.getRedirectURL()
# (https://<extension-id>.chromiumapp.org/) as an OAuth redirect URI.
# Required scopes (scoped apps): files.content.write, files.content.read,
# sharing.write, sharing.read, account_info.read.
DROPBOX_CLIENT_ID=
# Dropbox app secret — Worker only (never bundled into the extension).
DROPBOX_CLIENT_SECRET=
# Production multi-issuer Worker path, e.g.
# https://gn-tracing-oauth-proxy.<sub>.workers.dev/token/dropbox
DROPBOX_TOKEN_PROXY_URL=
# Dev default when empty: http://localhost:8787/token/dropbox (`task dev`).
DROPBOX_TOKEN_PROXY_URL_DEV=
# Optional product-feedback endpoint (POST). Defaults to
# {origin of GOOGLE_TOKEN_PROXY_URL or DROPBOX_TOKEN_PROXY_URL}/feedback.
# Dev default when empty: http://localhost:8787/feedback.
FEEDBACK_PROXY_URL=
FEEDBACK_PROXY_URL_DEV=
# Standalone player (Vite) feedback endpoint. Production Pages builds should set
# this to the deployed Worker /feedback URL so the hosted player can submit.
# Dev defaults to http://localhost:8787/feedback when host is localhost.
VITE_FEEDBACK_PROXY_URL=
# Fine-grained GitHub PAT (or App token) with issues:write on gnasdev/gn-tracing.
# Used ONLY by the Cloudflare Worker (`worker/deploy.sh` → wrangler secret).
# Never bundled into the extension.
GITHUB_FEEDBACK_TOKEN=
# Optional Worker vars for the feedback route (defaults: gnasdev / gn-tracing / feedback).
GITHUB_REPO_OWNER=gnasdev
GITHUB_REPO_NAME=gn-tracing
GITHUB_FEEDBACK_LABELS=feedback
# Optional override for which extension origins the Worker accepts. Defaults to
# chrome-extension://${CHROME_EXTENSION_ID}. Comma-separated for multiple.
WORKER_ALLOWED_EXTENSION_ORIGINS=
# Align with the Chrome Web Store item when shipping that listing.
# Public key is the Store item SPKI (base64). Leave private key empty when the
# key was assigned by the Store rather than generated locally.
CHROME_EXTENSION_ID=jbhlmonpecgenhinhffclanbbknjlbeh
CHROME_EXTENSION_PUBLIC_
CHROME_EXTENSION_PRIVATE_KEY=
# Chrome Web Store Publish API (scripts/chrome-webstore.mjs, task store:*).
# Reuses GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET above (Web application client
# must have https://developers.google.com/oauthplayground as redirect URI and
# scope https://www.googleapis.com/auth/chromewebstore when minting the token).
# Publisher ID: Developer Dashboard → Account/Publisher → Settings.
# Extension ID: same as CHROME_EXTENSION_ID when packaging for the Store item.
# Refresh token: OAuth Playground with the Web client + chromewebstore scope.
CHROME_WEBSTORE_PUBLISHER_ID=d6eb5431-a8e7-4369-a0e5-bf6bc136a947
CHROME_WEBSTORE_EXTENSION_ID=jbhlmonpecgenhinhffclanbbknjlbeh
CHROME_WEBSTORE_REFRESH_TOKEN=
# Cloudflare API token used by wrangler to deploy the OAuth Worker
# (worker/deploy.sh) and the replay player to Cloudflare Pages
# (player-standalone/deploy.sh). Those scripts read the process environment
# only (they do not source this file) — export the vars in your shell or CI.
# Create a token at https://dash.cloudflare.com/profile/api-tokens with
# permissions for Workers Scripts (Edit) and Cloudflare Pages (Edit).
CLOUDFLARE_API_TOKEN=
# Cloudflare account id that owns the Worker and Pages project. Find it in the
# Cloudflare dashboard URL or under Workers & Pages > Account details.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=gn-tracing-player
PLAYER_HOST_URL=https://tracing.gnas.dev/
PLAYER_LOCAL_PORT=5176
VITE_BASE_PATH=/
