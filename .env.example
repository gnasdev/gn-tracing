ENV=production
GOOGLE_CLIENT_ID=480452534376-na7me1e7ss7pmucni3vvkueai6gr8qpj.apps.googleusercontent.com
# OAuth client secret for the "Web application" client. Used ONLY by the
# Cloudflare Worker (worker/deploy.sh sets it as an encrypted secret). It is
# never bundled into the extension. Leave empty unless deploying the Worker.
GOOGLE_CLIENT_SECRET=
# URL of the deployed OAuth token-exchange Worker (e.g.
# https://gn-tracing-oauth-proxy.<subdomain>.workers.dev). When set, the
# extension sends token requests here instead of directly to Google, so the
# client_secret stays server-side. Leave empty to call Google directly (only
# works for public/installed OAuth clients that accept PKCE without a secret).
# For local Worker development, run `task worker:dev` and set this to
# http://localhost:8787 before rebuilding the extension.
GOOGLE_TOKEN_PROXY_URL=
# Optional override for which extension origins the Worker accepts. Defaults to
# chrome-extension://${CHROME_EXTENSION_ID}. Comma-separated for multiple.
WORKER_ALLOWED_EXTENSION_ORIGINS=
CHROME_EXTENSION_ID=fomajjkcepcijpnghnkplinhibgonlpg
CHROME_EXTENSION_PUBLIC_
CHROME_EXTENSION_PRIVATE_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=gn-tracing-player
PLAYER_HOST_URL=https://tracing.gnas.dev/
PLAYER_LOCAL_PORT=5176
VITE_BASE_PATH=/
